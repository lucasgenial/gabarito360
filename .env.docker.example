# Copie para .env.docker e substitua todos os valores marcados antes de homologar.
COMPOSE_PROJECT_NAME=gabarito360
G360_IMAGE_TAG=local
G360_HTTP_PORT=8080
G360_REVERB_PUBLIC_HOST=
G360_REVERB_PUBLIC_PORT=8080
G360_REVERB_PUBLIC_SCHEME=http

APP_NAME=Gabarito360
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_DATABASE=gabarito360
DB_USERNAME=gabarito360
DB_PASSWORD=troque-a-senha-do-banco
MARIADB_ROOT_PASSWORD=troque-a-senha-root

REDIS_PASSWORD=troque-a-senha-do-redis
REDIS_PREFIX=gabarito360_staging_
CACHE_PREFIX=gabarito360_staging_cache_

REVERB_APP_ID=gabarito360-staging
REVERB_APP_KEY=gabarito360-staging-key
REVERB_APP_SECRET=troque-o-segredo-do-reverb
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=nao-responder@gabarito360.local
MAIL_FROM_NAME=Gabarito360
